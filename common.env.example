LOG_LEVEL=INFO
CLOUDSTATION_ROOT=
CLOUDSTATION_ROOT_WINDOWS=D:\CloudStation
CLOUDSTATION_ROOT_MACOS=~/SynologyDrive
CLOUDSTATION_ROOT_LINUX=~/CloudStation
INPUT_PATH=./input/
OUTPUT_DIR=./output/
DEFAULT_ENTRY=ai_self_check

# 已由其他项目启动的 OpenAI 兼容 AI 服务。API key 仅保存在本机 common.env。
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=demo-model
LLAMACPP_API_KEY=
LLAMACPP_STATUS_TIMEOUT_SEC=3
LLAMACPP_STATUS_REFRESH_SEC=30

# 安卓交易流水采集 App；复制到 common.env 后按本机需要维护，可增加任意 App。
# reference_size=[参考宽,参考高]；swipe=[起点X,起点Y,终点X,终点Y,持续毫秒]
ANDROID_CAPTURE_APPS_JSON=[{"key":"sample_wallet","name":"示例钱包","output_dir":"./raw_data/android_transactions/sample_wallet","filename_prefix":"sample_wallet","reference_size":[1080,2400],"swipe":[540,1700,540,600,600]}]

JD_PDF_OUTPUT_DIR=./raw_data/jd_pdf
JD_BROWSER_USER_DATA_DIR=./raw_data/jd_browser_profile
JD_PDF_HEADLESS=false
JD_PDF_WAIT_SECONDS=5
JD_LOGIN_TIMEOUT_SECONDS=300

EXCEL_INPUT_FILE=
EXCEL_SHEET_NAME=
EXCEL_WORKBOOK_SHEETS_JSON={}
EXCEL_MAX_ROWS=80
EXCEL_MAX_COLS=30
EXCEL_MAX_CELL_CHARS=200
EXCEL_MAX_TOTAL_CHARS=24000
EXCEL_HEADER_ROW=3
EXCEL_DATA_START_ROW=4
EXCEL_PROBLEM_COLUMN=E
EXCEL_CATEGORY_HEADER=AI整理归类项
CATEGORY_DRAFT_OUTPUT_PATH=./output/category_skills_draft.md
CATEGORY_DRAFT_MAX_ROWS_PER_SHEET=20
CATEGORY_DRAFT_MAX_CONTEXT_CHARS=900
CATEGORY_DRAFT_MAX_TOKENS=4096
EXCEL_CLASSIFY_MAX_CONTEXT_CHARS=1000
EXCEL_CLASSIFY_MAX_TOKENS=32
CATEGORY_SEED_CATEGORIES_JSON=[]
EXCEL_AI_PROMPT=请阅读下面的 Excel 工作表内容，只输出6条要点，每条不超过40个汉字，覆盖主要事项、风险点和需跟进问题。
EXCEL_AI_MAX_TOKENS=512
EXCEL_AI_TIMEOUT_SEC=360
EXCEL_AI_OUTPUT_PATH=./output/excel_ai_response.md

FINANCIAL_EMAIL_IMAP_HOST=imap.126.com
FINANCIAL_EMAIL_IMAP_PORT=993
FINANCIAL_EMAIL_IMAP_USER=your-account@126.com
FINANCIAL_EMAIL_IMAP_PASSWORD=your-126-authorization-code
FINANCIAL_EMAIL_CLIENT_SUPPORT_EMAIL=support@example.invalid
FINANCIAL_EMAIL_MAILBOX=INBOX
FINANCIAL_EMAIL_SINCE=2024-01-01
FINANCIAL_EMAIL_BEFORE=
FINANCIAL_EMAIL_MAX_MESSAGES=200
FINANCIAL_EMAIL_OUTPUT_DIR=./raw_data/financial_email
FINANCIAL_EMAIL_SUBJECT_KEYWORDS_JSON=["银行","账单","流水","交易","动账","入账","扣款","信用卡","借记卡","电子回单","对账单"]

FINANCIAL_ATTACHMENT_PASSWORD_ENV_FILE=./financial_attachment_passwords.env

FINANCIAL_ATTACHMENT_HASHCAT_PATH=../hashcat/hashcat.exe
FINANCIAL_ATTACHMENT_ZIP2JOHN_PATH=../john-1.9.0-jumbo-1-win64/run/zip2john.exe
FINANCIAL_ATTACHMENT_PDF2JOHN_PATH=../john-1.9.0-jumbo-1-win64/run/pdf2john.pl
FINANCIAL_ATTACHMENT_HASHCAT_EXTRA_ARGS_JSON=["--backend-ignore-cuda","--backend-ignore-hip"]
